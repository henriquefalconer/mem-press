#!/bin/sh
# Run mem-press for the current environment. macOS/Linux build a cached native
# binary; Git Bash and WSL have a bundled native Windows fallback.
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SOURCE="$SCRIPT_DIR/mem-press.c"
BUNDLED_WINDOWS="$SCRIPT_DIR/mem-press.exe"

# A native Windows executable is included so Git Bash and WSL work without a
# compiler. When a compiler is available, rebuild from source as usual.
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) WINDOWS_BUILD=1; WSL_BUILD=0 ;;
    Linux)
        WINDOWS_BUILD=0
        # WSL can run the bundled Windows executable when no Linux compiler
        # is installed. Do not use it for ordinary Linux or macOS.
        if [ -n "${WSL_INTEROP:-}" ] || grep -qi microsoft /proc/version 2>/dev/null; then
            WSL_BUILD=1
        else
            WSL_BUILD=0
        fi
        ;;
    *) WINDOWS_BUILD=0; WSL_BUILD=0 ;;
esac

if command -v cc >/dev/null 2>&1; then
    CC=cc
elif command -v clang >/dev/null 2>&1; then
    CC=clang
elif command -v gcc >/dev/null 2>&1; then
    CC=gcc
else
    CC=
fi

if command -v sha256sum >/dev/null 2>&1; then
    HASH=$(sha256sum "$SOURCE" | awk '{print $1}')
elif command -v shasum >/dev/null 2>&1; then
    HASH=$(shasum -a 256 "$SOURCE" | awk '{print $1}')
else
    HASH=$(cksum "$SOURCE" | awk '{print $1 "-" $2}')
fi

KERNEL=$(uname -s)
case "$KERNEL" in
    MINGW*|MSYS*|CYGWIN*)
        # Keep artifacts in Git Bash's POSIX /tmp namespace. Native Windows
        # compilers cannot reliably consume a C:\\Users... path here.
        CACHE_ROOT=/tmp/mem-press
        # GCC/Clang on Windows use TMP/TEMP, even when launched by Git Bash.
        # Supply both native and POSIX forms so inherited C:\\ paths (and
        # trailing backslashes) cannot poison compiler temporary-file creation.
        export TMPDIR=/tmp
        if command -v cygpath >/dev/null 2>&1; then
            WINDOWS_TMP=$(cygpath -w /tmp)
        else
            WINDOWS_TMP=/tmp
        fi
        export TMP="$WINDOWS_TMP" TEMP="$WINDOWS_TMP"
        WINDOWS_BUILD=1
        ;;
    *)
        CACHE_ROOT=${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/mem-press
        WINDOWS_BUILD=0
        ;;
esac
mkdir -p "$CACHE_ROOT"
TARGET="$CACHE_ROOT/mem-press-$KERNEL-$(uname -m)-$HASH"
[ "$WINDOWS_BUILD" -eq 1 ] && TARGET="$TARGET.exe"

if [ "$WINDOWS_BUILD" -eq 1 ]; then
    LIBS="-lpsapi"
else
    LIBS="-lm"
fi

if [ ! -x "$TARGET" ] && [ -z "$CC" ] && [ "$WINDOWS_BUILD" -eq 1 -o "$WSL_BUILD" -eq 1 ] && [ -x "$BUNDLED_WINDOWS" ]; then
    # WSL executes this PE through its normal Windows interop; Git Bash runs it
    # natively. This is the dependency-free path.
    exec "$BUNDLED_WINDOWS" "$@"
fi

if [ ! -x "$TARGET" ]; then
    if [ -z "$CC" ]; then
        echo "mem-press: no usable C compiler found" >&2
        exit 127
    fi
    # Do not use mktemp's returned native path with a Windows compiler: some
    # MSYS combinations append a separator while converting it. A unique
    # output name is enough because compilation is atomic below.
    if [ "$WINDOWS_BUILD" -eq 1 ]; then
        OUTPUT="$CACHE_ROOT/.mem-press.$$.tmp.exe"
    else
        OUTPUT="$CACHE_ROOT/.mem-press.$$.tmp"
    fi
    trap 'rm -f "$OUTPUT"' EXIT HUP INT TERM
    "$CC" -O2 -Wall -Wextra -o "$OUTPUT" "$SOURCE" $LIBS
    chmod 755 "$OUTPUT"
    mv -f "$OUTPUT" "$TARGET"
    trap - EXIT HUP INT TERM
fi

exec "$TARGET" "$@"
